{
  "manifest_version": 3,
  "name": "Deadshot Extension",
  "version": "1.0.0",
  "description": "Export and Import Cookies and LocalStorage effortlessly.",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
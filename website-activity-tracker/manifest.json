{
  "manifest_version": 3,
  "name": "Universal Website Activity Tracker Pro",
  "version": "1.2",
  "description": "Auto-tracks user email/profile name, searches, clicks, section hold time, and hover duration with CSV export.",
  "permissions": ["storage", "identity", "identity.email"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
